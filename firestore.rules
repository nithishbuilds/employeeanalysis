rules_version = '2';
// Only the company account (signed in on the website) can read or write any data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "pentacledesignteam@gmail.com";
    }
  }
}
